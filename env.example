# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" pro GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=recomendaai

# Gere um valor aleatório forte, ex: openssl rand -hex 32
JWT_SECRET=troque_por_uma_string_aleatoria_bem_grande

PORT=3000

# Origem do seu front-end (onde o index.html é aberto/servido)
# Se você abre o index.html direto no navegador (file://), use "*"
FRONTEND_ORIGIN=*

# Chaves de API - agora ficam só aqui no backend, nunca no front-end
TMDB_API_KEY=sua_chave_tmdb_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
